{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc && npm run build:copy-assets",
    "build:copy-assets": "node -e \"const fs=require('fs'),path=require('path'),glob=require('glob');glob.sync('src/**/*.py').forEach(f=>{const d=f.replace('src/','dist/');fs.mkdirSync(path.dirname(d),{recursive:true});fs.copyFileSync(f,d);});\"",
    "start": "node dist/server.js",
    "dev": "nodemon src/server.ts",
    "test:e2e": "npx ts-node --project tsconfig.json --transpileOnly ../tests/e2e/e2e_validation.test.ts",
    "test:verify": "npx ts-node --project tsconfig.json --transpileOnly ../tests/e2e/verify_problems.e2e.test.ts",
    "test:python": "npx ts-node --project tsconfig.json --transpileOnly ../tests/unit/python_engine.test.ts",
    "test:cpp": "npx ts-node --project tsconfig.json --transpileOnly ../tests/unit/cpp_sheet.test.ts",
    "test:java": "npx ts-node --project tsconfig.json --transpileOnly ../tests/unit/java_compiler.test.ts",
    "test:java:validator": "npx ts-node --project tsconfig.json --transpileOnly ../tests/unit/java_validator.test.ts",
    "test:java:verify": "npx ts-node --project tsconfig.json --transpileOnly ../tests/e2e/verify_java_problems.e2e.test.ts",
    "test:java:trace": "npx ts-node --project tsconfig.json --transpileOnly ../tests/unit/java_trace.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^8.0.0",
    "@types/ws": "^8.18.1",
    "express": "^5.2.1",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "ws": "^8.18.3"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "axios": "^1.13.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "firebase-admin": "^13.8.0",
    "groq-sdk": "^0.37.0",
    "helmet": "^8.1.0",
    "mongoose": "^9.6.1",
    "nodemailer": "^8.0.10"
  }
}
